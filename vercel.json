{
  "builds": [
    {
      "src": "api/audit.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/audit",
      "dest": "api/audit.py"
    },
    {
      "src": "/",
      "dest": "web/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ]
}
